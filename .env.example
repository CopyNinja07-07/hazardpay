# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# PayPal sandbox app (https://developer.paypal.com -> Apps & Credentials -> Sandbox -> Create App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook id to verify PayPal webhook signatures
PAYPAL_WEBHOOK_ID=
# Secret used to sign policies
POLICY_SECRET=change-me
# 1 = force the offline demo even when keys exist
DEMO_MODE=
